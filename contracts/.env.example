# Avalanche Fuji only. Copy to .env and fill the three commented fields locally.
# The npm deploy script does not load .env automatically.
# After filling, deploy explicitly with Node 22+: node --env-file=.env scripts/deploy-fuji.mjs
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# DEPLOYER_PRIVATE_KEY=0x_REPLACE_WITH_TEST_WALLET_PRIVATE_KEY
# PLATFORM_ADDRESS=0x_REPLACE_WITH_PUBLIC_PLATFORM_ADDRESS
# SPONSOR_ADDRESS=0x_REPLACE_WITH_PUBLIC_SPONSOR_ADDRESS
# Sponsor is immutable. Verify its address before deployment.
# Never use the disposable keys from ../.local/test-chain.json on Fuji.
