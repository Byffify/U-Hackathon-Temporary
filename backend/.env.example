ENVIRONMENT=development
DATABASE_URL=sqlite:///./utopia.db
FRONTEND_ORIGINS=["http://localhost:4173","http://127.0.0.1:4173"]
AUTH_DOMAIN=localhost:4173
AUTH_URI=http://localhost:4173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CHALLENGE_TTL_SECONDS=300
SESSION_TTL_SECONDS=86400
AUTH_REQUESTS_PER_MINUTE=30
CHAIN_ID=658440
STORAGE_ROOT=.local
STORAGE_BACKEND=local
SOURCE_STORAGE_BACKEND=local
# Production: private Supabase bucket + encrypted IPFS, never ephemeral local files.
# STORAGE_BACKEND=supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=server-side-only
# SUPABASE_BUCKET=utopia-private
# SOURCE_STORAGE_BACKEND=ipfs
# IPFS_API_URL=https://your-kubo-compatible-rpc
# IPFS_API_AUTHORIZATION=Basic ...
# STORAGE_MASTER_KEY=base64-encoded-32-random-bytes
# PUBLIC_API_URL=https://your-backend.up.railway.app
# CHAIN_RPC_URL=https://nodes-prod.43.207.73.245.sslip.io/ext/bc/bARaPw7w2yF4w2dxMePasyxeJ4Ej8YVBwYsLyQB575VEStm8s/rpc
# MARKETPLACE_CONTRACT_ADDRESS=0x...
# SPONSOR_PRIVATE_KEY=server-side-only-test-wallet
CHAIN_CONFIRMATIONS=2
# Gemini: use a Free Tier project/key; this flag does not change Google's billing tier.
GEMINI_FREE_TIER_ENABLED=false
# GEMINI_API_KEY=server-side-only
# GEMINI_MODEL=choose-a-free-tier-model-available-to-your-project
# GEMINI_INITIAL_QUOTA=set-explicit-total-token-budget
# GEMINI_TRIAL_END=set-unix-expiry-timestamp
# GEMINI_ANALYSIS_BUDGET=set-explicit-request-budget
# GEMINI_GENERATION_BUDGET=set-explicit-generation-budget
# Optional Modal build check (credentials via MODAL_TOKEN_ID / MODAL_TOKEN_SECRET):
# MODAL_APP_NAME=existing-sandbox-app
# SANDBOX_IMAGE=python:3.12-slim
# SANDBOX_BUILD_COMMAND=["python","-m","compileall","-q","."]
# Pre-reviewed exact archive SHA256s only; unknown licenses remain blocked.
APPROVED_OPEN_SOURCE_HASHES=[]
